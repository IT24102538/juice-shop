# Environment secrets - NEVER commit these
  .env
  .env.local
  .env.production

  # Node modules (too large)
  node_modules/

  # Build output
  frontend/dist/

  # Logs
  *.log
  npm-debug.log*

  # OS files
  .DS_Store
  Thumbs.db

  # IDE
  .vscode/
  .idea/

  PowerShell command alternative:
    @"
.env
.env.local
node_modules/
frontend/dist/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
"@ | Set-Content .gitignore -Encoding UTF8